# Backend
PORT=4000
MONGODB_URI=mongodb://localhost:27017/junglesathi
JWT_SECRET=your-secret-key-here
MQTT_BROKER_URL=mqtt://localhost:1883

# Gateway (Forest Guard LoRa bridge)
# The gateway runs an embedded Aedes MQTT broker on 1883 and receives
# LoRa-style uplinks on the HTTP port below.
GATEWAY_PORT=4001
MQTT_BROKER_PORT=1883

# Firmware simulator (virtual LoRa nodes)
BACKEND_URL=http://localhost:4000
GATEWAY_UPLINK=http://localhost:4001/lora/uplink
SCENARIO_INTERVAL_MS=45000

# Dashboard
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000

# ML Service
ML_SERVICE_URL=http://localhost:8000
