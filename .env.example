# Backend
PORT=4000
MONGODB_URI=mongodb://localhost:27017/junglesathi
JWT_SECRET=your-secret-key-here
MQTT_BROKER_URL=mqtt://localhost:1883

# Gateway (Forest Guard LoRa bridge)
# The gateway runs an embedded Aedes MQTT broker on 1883 and receives
# LoRa-style uplinks on the HTTP port below.
GATEWAY_PORT=4001
MQTT_BROKER_PORT=1883

# Firmware simulator (virtual LoRa nodes)
BACKEND_URL=http://localhost:4000
GATEWAY_UPLINK=http://localhost:4001/lora/uplink
SCENARIO_INTERVAL_MS=45000

# Dashboard
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000

# ML Service
ML_SERVICE_URL=http://localhost:8000
ML_CONFIDENCE_THRESHOLD=0.85

# AI Chat — works out of the box with BlockRun (no key needed)
# Option A: BlockRun (free, no key, supports images/audio/video)
#   Model: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
#   Just leave FREEAI_API_KEY empty and it uses BlockRun automatically.
#
# Option B: Free.ai (sign up at https://free.ai/signup/ for 30K free tokens/day)
#   Uncomment below and add your sk-free-... key
# FREEAI_API_KEY=sk-free-your-key-here
# FREEAI_API_BASE_URL=https://api.free.ai/v1
# AI_MODEL=qwen25-vl
FREEAI_API_KEY=
FREEAI_API_BASE_URL=https://blockrun.ai/api/v1
AI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
AI_FALLBACK_ENABLED=true
